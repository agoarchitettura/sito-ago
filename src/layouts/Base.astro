---
import { u } from '../lib/url';
import '@fontsource/cuprum/400.css';
import '@fontsource/cuprum/500.css';
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { leggi } from '../lib/dati';
const { titolo, descrizione, immagine, home = false } = Astro.props;
const s = leggi('sito');
const url = new URL(Astro.url.pathname, Astro.site);
const t = home ? `${s.nome} — ${s.motto}` : `${titolo} — ${s.nome}`;
const d = descrizione ?? 'Società di progettazione di architetti a Macerata: progetto, restauro e direzione lavori per enti pubblici e committenti privati.';
const og = immagine ? new URL(immagine, Astro.site).href : new URL('/favicon.svg', Astro.site).href;
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', name: s.nome, legalName: s.ragione_sociale, url: String(Astro.site),
  logo: new URL('/favicon.svg', Astro.site).href, email: s.email, telephone: s.telefono_internazionale, vatID: `IT${s.piva}`,
  address: { '@type': 'PostalAddress', streetAddress: s.indirizzo, postalCode: s.cap, addressLocality: s.citta, addressRegion: s.provincia, addressCountry: 'IT' },
};
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{t}</title>
  <meta name="description" content={d}>
  <meta name="theme-color" content="#f9f9f6">
  {import.meta.env.PUBLIC_NOINDEX && <meta name="robots" content="noindex, nofollow">}
  <link rel="canonical" href={url.href}>
  <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')}>
  <meta property="og:type" content="website"><meta property="og:locale" content="it_IT">
  <meta property="og:title" content={t}><meta property="og:description" content={d}><meta property="og:url" content={url.href}><meta property="og:image" content={og}>
  <script type="application/ld+json" set:html={JSON.stringify(org)}></script>
</head>
<body>
  <Header />
  <main><slot /></main>
  <Footer />
  <div id="lb" role="dialog" aria-modal="true" aria-label="Immagine ingrandita"><button type="button" id="lb-x" aria-label="Chiudi">×</button><img alt=""><p></p></div>
  <script is:inline>
    (function(){
      var lb=document.getElementById('lb'); if(!lb) return;
      function chiudi(){lb.classList.remove('on');}
      document.addEventListener('click',function(e){
        var i=e.target.closest('[data-zoom]');
        if(i){lb.querySelector('img').src=i.getAttribute('data-zoom');lb.querySelector('p').textContent=i.getAttribute('data-cap')||'';lb.classList.add('on');e.preventDefault();return;}
        if(lb.classList.contains('on')&&e.target!==lb.querySelector('img'))chiudi();
      });
      addEventListener('keydown',function(e){if(e.key==='Escape')chiudi();});
    })();
  </script>
</body>
</html>
